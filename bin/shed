#!/usr/bin/env bash
set -euo pipefail
script=${BASH_SOURCE[0]}
while [[ -L $script ]]; do
    directory=$(cd -- "$(dirname -- "$script")" && pwd)
    script=$(readlink -- "$script")
    [[ $script == /* ]] || script="$directory/$script"
done
root=$(cd -- "$(dirname -- "$script")/.." && pwd)
case ${1:-} in
    available)
        [[ $# == 1 ]] || { printf 'Usage: shed available\n' >&2; exit 2; }
        exec python3 "$root/lib/tools.py" available "$root"
        ;;
    install)
        shift
        (( $# )) || { printf 'Usage: shed install TOOL...\n' >&2; exit 2; }
        for tool in "$@"; do "$root/lib/install-tool.sh" "$tool"; done
        ;;
    discover)
        if (( $# > 1 )); then
            shift
            for tool in "$@"; do "$root/lib/discover-tool.sh" "$tool"; done
            exit
        fi
        printf 'Updating Toolshed checkout...\n'
        git -C "$root" pull --ff-only
        source "$root/env"
        exec python3 "$root/lib/shed.py" discover "$TOOLSHED_BIN_DIR" "$TOOLSHED_OPT_DIR" "$TOOLSHED_NVM_DIR"
        ;;
    update)
        shift
        source "$root/env"
        exec python3 "$root/lib/shed.py" update "$TOOLSHED_BIN_DIR" "$TOOLSHED_OPT_DIR" "$TOOLSHED_NVM_DIR" "$@"
        ;;
    installed)
        [[ $# == 1 ]] || { printf 'Usage: shed installed\n' >&2; exit 2; }
        source "$root/env"
        exec python3 "$root/lib/shed.py" "$1" "$TOOLSHED_BIN_DIR" "$TOOLSHED_OPT_DIR" "$TOOLSHED_NVM_DIR"
        ;;
    -h|--help|'') printf 'Usage: shed {available|installed|install TOOL...|update [--delay-days DAYS]|discover [TOOL...]}\n' ;;
    *) printf 'Unknown command: %s\nUsage: shed {available|installed|install|update|discover}\n' "$1" >&2; exit 2 ;;
esac
