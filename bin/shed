#!/usr/bin/env bash
set -euo pipefail
script=${BASH_SOURCE[0]}
while [[ -L $script ]]; do
    directory=$(cd -- "$(dirname -- "$script")" && pwd)
    script=$(readlink -- "$script")
    [[ $script == /* ]] || script="$directory/$script"
done
root=$(cd -- "$(dirname -- "$script")/.." && pwd)
source "$root/lib/install.sh"
source "$root/lib/tool.sh"
source "$root/lib/shed.sh"
usage='Usage: shed {available|installed|install TOOL...|update [--delay-days DAYS]|discover [TOOL...]}'
case ${1:-} in
    available)
        [[ $# == 1 ]] || { printf 'Usage: shed available\n' >&2; exit 2; }
        toolshed_init
        shed_available
        ;;
    discoverable) # For automation: the tools that have a release discovery.
        shed_discoverable
        ;;
    install)
        shift
        (( $# )) || { printf 'Usage: shed install TOOL...\n' >&2; exit 2; }
        for tool in "$@"; do "$root/lib/install-tool.sh" "$tool"; done
        ;;
    discover)
        if (( $# > 1 )); then
            shift
            for tool in "$@"; do "$root/lib/discover-tool.sh" "$tool"; done
            exit
        fi
        printf 'Updating Toolshed checkout...\n'
        git -C "$root" pull --ff-only
        toolshed_init
        shed_run discover
        ;;
    update)
        shift
        delay=8
        while (( $# )); do
            case $1 in
                --delay-days) (( $# > 1 )) || set -- "$1" ''; delay=$2; shift 2 ;;
                --delay-days=*) delay=${1#*=}; shift ;;
                *) printf 'Usage: shed update [--delay-days DAYS]\n' >&2; exit 2 ;;
            esac
        done
        [[ $delay =~ ^[0-9]+$ ]] || { printf 'shed update: --delay-days must be a non-negative integer\n' >&2; exit 2; }
        toolshed_init
        shed_run update "$((10#$delay))"
        ;;
    installed)
        [[ $# == 1 ]] || { printf 'Usage: shed installed\n' >&2; exit 2; }
        toolshed_init
        shed_installed
        ;;
    -h|--help|'') printf '%s\n' "$usage" ;;
    *) printf 'Unknown command: %s\n%s\n' "$1" "$usage" >&2; exit 2 ;;
esac
